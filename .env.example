# ==============================================================================
# DZMenu Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Authentication (SERVER-ONLY)
# Strong random secret for signing and verifying sessions (minimum 32 characters)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# Database Configuration (SERVER-ONLY)
# PostgreSQL connection string with pooling support
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://dzmenu_user:dzmenu_password@localhost:5432/dzmenu_db?sslmode=disable"
